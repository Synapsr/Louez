# Copy to a private environment file. Never commit real credentials.
PORT=8080
APP_URL=https://app.example.com
VOICE_RELAY_WS_URL=wss://voice.example.com
VOICE_RELAY_SIGNING_SECRET=replace-with-at-least-32-random-characters
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# OpenAI project with access to GPT-Live and the configured Responses model.
# This key belongs only to the worker, never to the browser or TwiML.
OPENAI_API_KEY=
# Must match AI_PHONE_LIVE_MODEL on the web app (also used by voice previews).
AI_PHONE_LIVE_MODEL=gpt-live-1
MAX_CONCURRENT_CALLS=50
VOICE_IDLE_SECONDS=60
VOICE_VAD_THRESHOLD=900
