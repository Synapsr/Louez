    "evlog": "^2.16.0",
    "ws": "^8.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
