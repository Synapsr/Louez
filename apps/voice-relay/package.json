{
  "name": "@louez/voice-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Authenticated Twilio Media Streams bridge to OpenAI GPT-Live. Business tools remain in the web app.",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
