# ===========================================
# Louez - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# See README.md for detailed documentation

# -----------------------------------------
# Deployment mode
# -----------------------------------------
# standalone (default when unset): single store on a single origin —
#   storefront at the root, dashboard under /dashboard.
# platform: multi-tenant subdomain routing (dashboard on its own subdomain,
#   one storefront per store subdomain).
LOUEZ_MODE="standalone"

# -----------------------------------------
# Database (Required)
# -----------------------------------------
# MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/louez"

# -----------------------------------------
# Authentication (Required)
# -----------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Auth URL - Must match your dashboard URL (where users log in)
# Examples: http://localhost:3000 (dev) | https://app.yourdomain.com (prod)
AUTH_URL="http://localhost:3000"

# Trust Host - Set to true when behind a reverse proxy (Docker, Cloudflare, etc.)
AUTH_TRUST_HOST="true"

# Google OAuth (Required for Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------
# Email / SMTP (Required)
# -----------------------------------------
# Any SMTP provider works: Gmail, SendGrid, Mailgun, AWS SES, Resend, etc.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resend"
SMTP_PASSWORD=""
SMTP_FROM="Louez <noreply@yourdomain.com>"

# -----------------------------------------
# Application URLs (Required)
# -----------------------------------------
# Base URL and domain for your installation
# Examples: http://localhost:3000 / localhost:3000 (dev)
#           https://app.yourdomain.com / yourdomain.com (prod)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"

# Subdomain used for the admin dashboard (default: "app")
# Dashboard will be accessible at: {DASHBOARD_SUBDOMAIN}.{APP_DOMAIN}
NEXT_PUBLIC_DASHBOARD_SUBDOMAIN="app"

# Optional regional formatting override, e.g. "de-AT" while the UI is German.
NEXT_PUBLIC_FORMAT_LOCALE=""

# -----------------------------------------
# Storage / S3 (Required)
# -----------------------------------------
# For image uploads. S3-compatible providers:
# AWS S3, Scaleway Object Storage, MinIO, Cloudflare R2, DigitalOcean Spaces
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION="fr-par"
S3_BUCKET="louez-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://louez-uploads.s3.fr-par.scw.cloud"

# -----------------------------------------
# Stripe (Required)
# -----------------------------------------
# For online payments with Stripe Connect
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -----------------------------------------
# Web Push (Optional)
# -----------------------------------------
# Generate the key pair once and keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: address or HTTPS URL identifying the push sender.
VAPID_SUBJECT=""

# Stripe Price IDs (EUR) - Create in Stripe Dashboard
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ULTRA_MONTHLY=""
STRIPE_PRICE_ULTRA_YEARLY=""

# Stripe Price IDs (USD) - Create in Stripe Dashboard
STRIPE_PRICE_PRO_MONTHLY_USD=""
STRIPE_PRICE_PRO_YEARLY_USD=""
STRIPE_PRICE_ULTRA_MONTHLY_USD=""
STRIPE_PRICE_ULTRA_YEARLY_USD=""

# -----------------------------------------
# SMS (Required)
# -----------------------------------------
# For sending SMS notifications to customers
# Provider options: smspartner, twilio, vonage
SMS_PROVIDER="smspartner"
SMS_DEFAULT_SENDER="Louez"

# SMS Partner (https://www.smspartner.fr)
# Get your API key from: https://my.smspartner.fr/api
SMS_PARTNER_API_KEY=""

# -----------------------------------------
# Google Places (Required)
# -----------------------------------------
# For address autocomplete/search.
# Enable both Places API and Routes API on the same key to get route-based delivery distances.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_CACHE_TTL_HOURS="24"

# -----------------------------------------
# Platform Admin (Required)
# -----------------------------------------
# Comma-separated list of emails with platform-wide admin access.
# These users can access ALL stores in the store switcher for support/debugging.
# Leave empty to disable this feature.
PLATFORM_ADMIN_EMAILS=""

# -----------------------------------------
# Discord Notifications (Required)
# -----------------------------------------
# Discord webhook URL for platform-wide admin notifications.
# When set, key platform events (sign-ups, reservations, payments, etc.)
# are sent as single-line messages to this Discord channel in real-time.
# Create a webhook: Discord Server Settings > Integrations > Webhooks > New Webhook
DISCORD_ADMIN_WEBHOOK_URL=""

# -----------------------------------------
# Integrations (Optional)
# -----------------------------------------
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
INTEGRATION_ENCRYPTION_KEY=""

# Generate a separate stable 32-byte base64url key for the restricted legal archive.
LEGAL_ARCHIVE_ENCRYPTION_KEY=""
# Louez's own accounting year end, used to compute the ten-year legal expiry.
LEGAL_ARCHIVE_FISCAL_YEAR_END="12-31"

# Private credentials used only to erase identified users from optional
# analytics/support processors. Required when the matching public SDK is enabled.
POSTHOG_API_HOST="https://eu.posthog.com"
POSTHOG_PROJECT_ID=""
POSTHOG_PERSONAL_API_KEY=""
GLEAP_API_TOKEN=""
OPENREPLAY_API_URL=""
OPENREPLAY_ORGANIZATION_API_KEY=""

# Google Calendar OAuth integration
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# -----------------------------------------
# Cron Jobs (Required)
# -----------------------------------------
# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Shared HMAC secret for Marketplace catalog pulls. Catalog routes return 401
# while this is unset. Generate with: openssl rand -base64 32
MARKETPLACE_CATALOG_SECRET=""

# Public origin of the Louez Marketplace. Used server-side to read the shared
# product taxonomy for the "Sales channels" settings page. Unset or unreachable
# => the category mapping editor degrades to free slug input.
MARKETPLACE_URL=""

# -----------------------------------------
# AI (Optional)
# -----------------------------------------
# Powers the dashboard AI assistant and the storefront AI advisor.
# Both features stay hidden when unset.
# AI_PROVIDER: anthropic | openai | google
AI_PROVIDER=""
AI_API_KEY=""
# Optional model override (defaults per provider)
AI_MODEL=""
# Optional cheaper model for the public storefront advisor
# (falls back to AI_MODEL, then the provider default)
AI_ADVISOR_MODEL=""
# Optional per-store daily message cap for the storefront advisor (default 500)
AI_ADVISOR_DAILY_STORE_LIMIT=""

# --- Product image processing (optional) ---
# Private rembg service used by BOTH direct background removal and the final
# isolation step after an AI enhancement.
AI_IMAGE_BACKGROUND_REMOVAL_URL=""
# Bearer token shared with the worker when it is reachable publicly (32+ chars)
AI_IMAGE_BACKGROUND_REMOVAL_TOKEN=""
# OpenAI image edits. AI enhancement is enabled only when this key (or
# AI_API_KEY with AI_PROVIDER="openai") and the rembg URL above both resolve.
AI_IMAGE_OPENAI_API_KEY=""
# Optional GPT Image 2-compatible model override (default gpt-image-2)
AI_IMAGE_MODEL=""
# Render quality: low | medium | high (default medium)
AI_IMAGE_QUALITY=""
# Flat credits billed per enhanced image when AI credits are active (default 2)
AI_IMAGE_ENHANCE_CREDITS="2"
# Flat credits per standalone background removal (default 0 = free)
AI_IMAGE_BG_REMOVAL_CREDITS=""
# GPT Image token prices in USD per 1M tokens (GPT Image 2 defaults)
AI_IMAGE_TEXT_INPUT_USD_PER_MTOK="5"
AI_IMAGE_INPUT_USD_PER_MTOK="8"
AI_IMAGE_OUTPUT_USD_PER_MTOK="30"
# Fallback provider cost per image when token usage is absent
AI_IMAGE_USD_PER_IMAGE=""
# Optional USD → EUR rate for estimated margin on /dev/image-processing
AI_IMAGE_USD_TO_EUR_RATE=""
# Persist private comparison artifacts and enable /dev/image-processing.
# Local development enables it automatically; set true explicitly in preprod.
AI_IMAGE_DEBUG_ENABLED=""

# --- AI credits (optional — cloud commercial layer) ---
# Shared prepaid wallet consumed by the storefront advisor, the voice agent,
# phone-number rental and AI image enhancement. Hidden when unset (self-host).
AI_CREDITS_ENABLED=""
# USD cost that equals 1 credit for token-metered usage (unset = metering off)
AI_CREDIT_COST_BASIS_USD=""
# Prepaid credits gifted to a NEW store at onboarding (default 0)
FREE_AI_CREDITS=""
# Monthly included credits per plan slug, JSON, e.g. {"free":5,"pro":50}
AI_CREDIT_MONTHLY_INCLUDED=""
# Purchasable packs, JSON array, e.g. [{"credits":100,"priceCents":900}]
AI_CREDIT_PACKAGES=""

# -----------------------------------------
# PostHog Analytics (Required)
# -----------------------------------------
# Product analytics, feature flags, and session replay
# Get your keys from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Optional override; Docker builds generate one automatically when omitted
NEXT_PUBLIC_APP_VERSION=""

# -----------------------------------------
# Umami Analytics (Required)
# -----------------------------------------
# Privacy-friendly analytics for your platform
# Full URL to your Umami tracking script
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
# Website ID from your Umami dashboard (Settings > Websites > Edit)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# -----------------------------------------
# Gleap (Required)
# -----------------------------------------
# For in-app feedback and bug reporting in the dashboard
NEXT_PUBLIC_GLEAP_API_KEY=""

# -----------------------------------------
# OpenReplay (Optional)
# -----------------------------------------
# Session replay. Disabled unless the ingest point and a surface project key are set.
# Use separate projects for dashboard and storefront.
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=""
NEXT_PUBLIC_OPENREPLAY_STOREFRONT_PROJECT_KEY=""
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT=""

# -----------------------------------------
# Development Mode (Optional)
# -----------------------------------------
# Set to a store slug to preview that store's storefront locally
# When set, localhost will show the storefront instead of the dashboard
# Dashboard routes (/dashboard, /login, etc.) remain accessible
PREVIEW_STORE_SLUG=""

# Auto-run migrations on server start (dev only)
AUTO_DB_SETUP="false"

# Skip env validation during build (use with caution)
# SKIP_ENV_VALIDATION="true"
