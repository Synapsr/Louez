# syntax=docker/dockerfile:1

# =============================================================================
# Louez Web Migrator - Production Dockerfile (Turborepo Monorepo)
# =============================================================================
# Use this file when your platform does not support Docker build targets.
# It builds and runs only the migration job.
# =============================================================================

FROM node:22.23.4-alpine AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/validations/package.json ./packages/validations/
COPY packages/voice/package.json ./packages/voice/
COPY packages/db/package.json ./packages/db/
COPY packages/ui/package.json ./packages/ui/
COPY packages/email/package.json ./packages/email/
COPY packages/pdf/package.json ./packages/pdf/
COPY packages/mcp/package.json ./packages/mcp/
COPY apps/web/package.json ./apps/web/
COPY apps/voice-relay/package.json ./apps/voice-relay/

# The first pnpm invocation also makes corepack download the pinned pnpm from
# the npm registry — the stage's first network access — so both are retried:
# build hosts occasionally fail DNS resolution transiently (EAI_AGAIN) and a
# blind retry is all it takes.
RUN corepack enable pnpm && \
    (pnpm install --frozen-lockfile || \
     (sleep 10 && pnpm install --frozen-lockfile) || \
     (sleep 30 && pnpm install --frozen-lockfile))

FROM node:22.23.4-alpine AS builder

WORKDIR /app

ARG SKIP_ENV_VALIDATION=true
ARG DATABASE_URL

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=deps /app/packages/auth/node_modules ./packages/auth/node_modules
# @louez/config is source-only and has no node_modules directory.
COPY --from=deps /app/packages/types/node_modules ./packages/types/node_modules
COPY --from=deps /app/packages/utils/node_modules ./packages/utils/node_modules
COPY --from=deps /app/packages/validations/node_modules ./packages/validations/node_modules
COPY --from=deps /app/packages/voice/node_modules ./packages/voice/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/ui/node_modules ./packages/ui/node_modules
COPY --from=deps /app/packages/email/node_modules ./packages/email/node_modules
COPY --from=deps /app/packages/pdf/node_modules ./packages/pdf/node_modules
COPY --from=deps /app/packages/mcp/node_modules ./packages/mcp/node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV SKIP_ENV_VALIDATION=${SKIP_ENV_VALIDATION}
ENV DATABASE_URL=${DATABASE_URL}

# Reuse the pnpm tarball corepack already fetched in `deps`. Each stage has its
# own filesystem, so without this the builder downloads pnpm from the npm
# registry a second time — a second chance for a build to die on a transient DNS
# or registry failure, having nothing to do with the code being built.
COPY --from=deps /root/.cache/node/corepack /root/.cache/node/corepack

RUN corepack enable pnpm && pnpm turbo run build --filter=@louez/web --env-mode=loose

FROM node:22.23.4-alpine AS migrator

WORKDIR /app

ENV NODE_ENV=production

# Copy node_modules needed by migrate.mjs (drizzle-orm, mysql2, and their deps)
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules

# Copy migration script and migration files
COPY --from=builder /app/docker/migrate.mjs ./docker/migrate.mjs
COPY --from=builder /app/packages/db/src/migrations ./migrations

CMD ["node", "docker/migrate.mjs"]
