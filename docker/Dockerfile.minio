# syntax=docker/dockerfile:1

# =============================================================================
# Louez image store — MinIO with the product bucket pre-created
# =============================================================================
# A bucket is a top-level directory of MinIO's data drive, so creating it at
# startup needs no `mc` job (the Compose stack does the same). This image exists
# for platforms that run long-lived services only and cannot override a
# container's entrypoint (Render), where the image's `minio` entrypoint would
# otherwise receive the shell command as arguments and refuse to start.
#
# MinIO no longer publishes images, so this builds on Chainguard's rebuild
# (same binary and on-disk format as the former minio/minio image).
#
# Build: docker build -f docker/Dockerfile.minio -t louez-minio docker
# =============================================================================

FROM cgr.dev/chainguard/minio:latest

# Disks written by the former upstream image are root-owned; the Chainguard
# default user (uid 65532) could not write to them.
USER root

EXPOSE 9000

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["mkdir -p /data/${S3_BUCKET:-louez} && exec minio server /data"]
