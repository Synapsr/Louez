{
  "name": "@louez/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./platform/*": "./src/platform/*.ts",
    "./router": "./src/router.ts",
    "./services": "./src/services/index.ts",
    "./services/agent-grants": "./src/services/agent-grants.ts",
    "./services/categories": "./src/services/categories.ts",
    "./services/customer-fields": "./src/services/customer-fields.ts",
    "./services/customer-fields-online": "./src/services/customer-fields-online.ts",
    "./services/customer-profile-fields": "./src/services/customer-profile-fields.ts",
    "./services/customer-tools": "./src/services/customer-tools.ts",
    "./services/marketplace-default-publication": "./src/services/marketplace-default-publication.ts",
    "./services/pricing-catalog": "./src/services/pricing-catalog.ts",
    "./services/promo": "./src/services/promo.ts"
  },
  "scripts": {
    "test": "SKIP_ENV_VALIDATION=true node --import tsx --experimental-test-module-mocks --test \"src/**/*.test.{ts,mjs}\""
  },
  "dependencies": {
    "@louez/auth": "workspace:*",
    "@louez/db": "workspace:*",
    "@louez/types": "workspace:*",
    "@louez/utils": "workspace:*",
    "@louez/validations": "workspace:*",
    "@orpc/contract": "1.14.14",
    "@orpc/openapi": "1.14.14",
    "@orpc/server": "1.14.14",
    "@orpc/zod": "1.14.14",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@louez/config": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
